# Streamlick Frontend Configuration

# Backend API URL
VITE_API_URL=http://localhost:3000

# Stripe (for payments)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Ant Media Server (for multi-guest SFU)
VITE_ANT_MEDIA_SERVER_URL=https://media.streamlick.com:5443
VITE_ANT_MEDIA_APP_NAME=StreamLick

# RTMP Relay (for platforms that don't support WHIP)
# This is a lightweight relay that converts WebRTC to RTMP
VITE_RTMP_RELAY_URL=wss://media.streamlick.com:5443

# TURN Server Configuration (required for guests behind symmetric NATs)
# Options: coturn (self-hosted), Twilio, Metered.ca, Xirsys
# Format: turn:hostname:port or turns:hostname:port for TLS
VITE_TURN_SERVER_URL=
VITE_TURN_SERVER_USERNAME=
VITE_TURN_SERVER_CREDENTIAL=
