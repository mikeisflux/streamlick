# Streamlick Frontend Configuration

# Backend API URL
VITE_API_URL=http://localhost:3000

# Stripe (for payments)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# LiveKit Server (for multi-guest SFU)
# Use wss:// without port to go through nginx proxy on 443
VITE_LIVEKIT_URL=wss://media.streamlick.com

# RTMP Relay (for platforms that don't support WHIP)
VITE_RTMP_RELAY_URL=wss://media.streamlick.com

# TURN Server Configuration (required for guests behind symmetric NATs)
# Options: coturn (self-hosted), Twilio, Metered.ca, Xirsys
# Format: turn:hostname:port or turns:hostname:port for TLS
VITE_TURN_SERVER_URL=
VITE_TURN_SERVER_USERNAME=
VITE_TURN_SERVER_CREDENTIAL=
