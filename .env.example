# Database
DATABASE_URL="postgresql://user:password@localhost:5432/streamlick?schema=public"

# JWT Secret
JWT_SECRET="your-jwt-secret-change-in-production"

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:3000"

# ============================================================
# Ant Media Server Configuration
# ============================================================
# Base URL of your AMS instance (HTTPS in production)
ANTMEDIA_URL="https://media.example.com:5443"
# AMS application name (default LiveApp for community edition)
ANTMEDIA_APP="LiveApp"
# AMS REST API credentials (set in AMS Management Panel)
ANTMEDIA_REST_USER="your-ams-admin-user"
ANTMEDIA_REST_PASS="your-ams-admin-password"

# WebSocket URL for AMS WebRTC signaling (derived from ANTMEDIA_URL if not set)
# ANTMEDIA_WS_URL="wss://media.example.com:5443/LiveApp/websocket"

# URL where the compositor HTML is served from (AMS Tomcat serves it)
# COMPOSITOR_HTML_URL="https://media.example.com:5443/LiveApp/streamlick_composite.html"

# ============================================================
# Compositor Security
# ============================================================
# Secret used to authenticate compositor WebSocket connections
# Must match the compositorSecret in streamlick_composite.html
COMPOSITOR_SECRET="change-this-to-a-secure-random-string"

# Path to headless Chrome/Chromium (auto-detected if not set)
# CHROME_PATH="/usr/bin/google-chrome"

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"
