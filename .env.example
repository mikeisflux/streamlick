# Database
DATABASE_URL="postgresql://user:password@localhost:5432/streamlick?schema=public"

# JWT Secret
JWT_SECRET="your-jwt-secret-change-in-production"

# Server
PORT=3000
NODE_ENV=development

# Ant Media Server
ANT_MEDIA_URL="wss://your-ant-media-server:5443/WebRTCAppEE/websocket"
ANT_MEDIA_REST_URL="https://your-ant-media-server:5443/WebRTCAppEE/rest/v2"

# Compositor
COMPOSITOR_URL="http://localhost:3001"

# RTMP Output
RTMP_SERVER_URL="rtmp://localhost:1935/live"

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"
