generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  avatar       String?
  role         UserRole      @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  broadcasts   Broadcast[]
  destinations Destination[]

  @@index([email])
}

model Broadcast {
  id              String            @id @default(cuid())
  title           String
  description     String?
  status          BroadcastStatus   @default(IDLE)
  streamKey       String            @unique
  previewUrl      String?
  layout          String            @default("grid")
  backgroundColor String            @default("#1a1a2e")
  logoUrl         String?
  overlayText     String?
  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  userId          String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  outputs         BroadcastOutput[]
  participants    Participant[]
  recordings      Recording[]

  @@index([userId])
  @@index([status])
  @@index([streamKey])
}

model Participant {
  id           String            @id @default(cuid())
  name         String
  email        String?
  role         ParticipantRole   @default(GUEST)
  status       ParticipantStatus @default(WAITING)
  streamId     String?
  audioEnabled Boolean           @default(true)
  videoEnabled Boolean           @default(true)
  position     Int               @default(0)
  isOnStage    Boolean           @default(false)
  inviteToken  String            @unique
  broadcastId  String
  userId       String?
  joinedAt     DateTime?
  leftAt       DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  broadcast    Broadcast         @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
  @@index([inviteToken])
  @@index([streamId])
}

model Destination {
  id           String            @id @default(cuid())
  name         String
  platform     Platform
  rtmpUrl      String
  streamKey    String
  platformId   String?
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?
  userId       String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  outputs      BroadcastOutput[]
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
}

model BroadcastOutput {
  id            String       @id @default(cuid())
  status        OutputStatus @default(IDLE)
  broadcastId   String
  destinationId String
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  broadcast     Broadcast    @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  destination   Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, destinationId])
  @@index([broadcastId])
  @@index([destinationId])
}

model Recording {
  id          String          @id @default(cuid())
  filename    String
  fileUrl     String?
  fileSize    BigInt?
  duration    Int?
  status      RecordingStatus @default(RECORDING)
  broadcastId String
  startedAt   DateTime        @default(now())
  endedAt     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  broadcast   Broadcast       @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
}

enum BroadcastStatus {
  IDLE
  GREENROOM
  LIVE
  ENDED
}

enum OutputStatus {
  IDLE
  STARTING
  LIVE
  ERROR
  STOPPED
}

enum ParticipantRole {
  HOST
  COHOST
  GUEST
}

enum ParticipantStatus {
  WAITING
  GREENROOM
  ONSTAGE
  LEFT
}

enum Platform {
  YOUTUBE
  TWITCH
  FACEBOOK
  CUSTOM_RTMP
}

enum RecordingStatus {
  RECORDING
  PROCESSING
  READY
  FAILED
}

enum UserRole {
  USER
  ADMIN
}
