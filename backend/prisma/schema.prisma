generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  avatar        String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  broadcasts    Broadcast[]
  destinations  Destination[]

  @@index([email])
}

enum UserRole {
  USER
  ADMIN
}

// ============================================================================
// BROADCASTS (Live Streaming Sessions)
// ============================================================================

model Broadcast {
  id            String          @id @default(cuid())
  title         String
  description   String?
  status        BroadcastStatus @default(IDLE)

  // Stream configuration
  streamKey     String          @unique @default(cuid())
  previewUrl    String?         // WebRTC preview URL for clients

  // Layout & branding
  layout        String          @default("grid") // grid, spotlight, side-by-side, etc.
  backgroundColor String        @default("#1a1a2e")
  logoUrl       String?
  overlayText   String?

  // Timing
  scheduledAt   DateTime?
  startedAt     DateTime?
  endedAt       DateTime?

  // Owner
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  participants  Participant[]
  outputs       BroadcastOutput[]
  recordings    Recording[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@index([streamKey])
}

enum BroadcastStatus {
  IDLE        // Not started
  GREENROOM   // Participants can join, not live
  LIVE        // Broadcasting to destinations
  ENDED       // Broadcast finished
}

// ============================================================================
// PARTICIPANTS (Host + Guests in a broadcast)
// ============================================================================

model Participant {
  id            String            @id @default(cuid())
  name          String
  email         String?
  role          ParticipantRole   @default(GUEST)
  status        ParticipantStatus @default(WAITING)

  // Ant Media stream identifiers
  streamId      String?           // Unique stream ID in Ant Media
  audioEnabled  Boolean           @default(true)
  videoEnabled  Boolean           @default(true)

  // Position in layout
  position      Int               @default(0)
  isOnStage     Boolean           @default(false)

  // Invite link
  inviteToken   String            @unique @default(cuid())

  // Parent broadcast
  broadcastId   String
  broadcast     Broadcast         @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  // If this is the host, link to user
  userId        String?

  joinedAt      DateTime?
  leftAt        DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([broadcastId])
  @@index([inviteToken])
  @@index([streamId])
}

enum ParticipantRole {
  HOST
  COHOST
  GUEST
}

enum ParticipantStatus {
  WAITING     // Invited but not connected
  GREENROOM   // In greenroom, not on stage
  ONSTAGE     // Visible in broadcast
  LEFT        // Disconnected
}

// ============================================================================
// DESTINATIONS (RTMP outputs to platforms)
// ============================================================================

model Destination {
  id            String          @id @default(cuid())
  name          String          // e.g., "My YouTube Channel"
  platform      Platform

  // RTMP credentials
  rtmpUrl       String
  streamKey     String

  // Platform-specific
  platformId    String?         // External platform ID
  accessToken   String?         // OAuth token if needed
  refreshToken  String?
  tokenExpiry   DateTime?

  // Owner
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Outputs using this destination
  outputs       BroadcastOutput[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([platform])
}

enum Platform {
  YOUTUBE
  TWITCH
  FACEBOOK
  CUSTOM_RTMP
}

// ============================================================================
// BROADCAST OUTPUTS (Active streams to destinations)
// ============================================================================

model BroadcastOutput {
  id            String        @id @default(cuid())
  status        OutputStatus  @default(IDLE)

  // Parent broadcast
  broadcastId   String
  broadcast     Broadcast     @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  // Target destination
  destinationId String
  destination   Destination   @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  // Stream info
  startedAt     DateTime?
  endedAt       DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([broadcastId, destinationId])
  @@index([broadcastId])
  @@index([destinationId])
}

enum OutputStatus {
  IDLE
  STARTING
  LIVE
  ERROR
  STOPPED
}

// ============================================================================
// RECORDINGS
// ============================================================================

model Recording {
  id            String          @id @default(cuid())
  filename      String
  fileUrl       String?
  fileSize      BigInt?
  duration      Int?            // Duration in seconds
  status        RecordingStatus @default(RECORDING)

  // Parent broadcast
  broadcastId   String
  broadcast     Broadcast       @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  startedAt     DateTime        @default(now())
  endedAt       DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([broadcastId])
}

enum RecordingStatus {
  RECORDING
  PROCESSING
  READY
  FAILED
}
