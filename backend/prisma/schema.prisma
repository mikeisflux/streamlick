generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  password                String    // Hashed password
  name                    String?
  avatarUrl               String?
  role                    String    @default("USER")
  planType                String    @default("free")
  emailVerified           Boolean   @default(false)
  emailVerificationToken  String?
  emailVerificationExpiry DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  broadcasts    Broadcast[]
  destinations  Destination[]
  participants  Participant[]

  @@index([email])
}

// ============================================================================
// BROADCASTS (Live Streaming Sessions)
// ============================================================================

model Broadcast {
  id              String    @id @default(cuid())
  title           String
  description     String?
  status          String    @default("IDLE")

  // Studio configuration stored as JSON
  studioConfig    Json?     @default("{}")

  // Timing
  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?

  // Owner
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  participants    Participant[]
  destinations    BroadcastDestination[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

// ============================================================================
// PARTICIPANTS (Host + Guests in a broadcast)
// ============================================================================

model Participant {
  id              String    @id @default(cuid())
  name            String?
  role            String?   @default("GUEST")
  status          String?   @default("WAITING")

  // Invite link
  joinLinkToken   String?   @unique @default(cuid())
  joinLinkExpiry  DateTime?

  // Parent broadcast
  broadcastId     String
  broadcast       Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  // If this is the host, link to user
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  joinedAt        DateTime?
  leftAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([broadcastId])
  @@index([joinLinkToken])
}

// ============================================================================
// DESTINATIONS (RTMP outputs to platforms)
// ============================================================================

model Destination {
  id            String    @id @default(cuid())
  name          String
  platform      String    @default("CUSTOM_RTMP")

  // RTMP credentials
  rtmpUrl       String
  streamKey     String

  // Platform-specific
  platformId    String?
  accessToken   String?
  refreshToken  String?
  tokenExpiry   DateTime?

  // Owner
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Outputs using this destination
  broadcasts    BroadcastDestination[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([platform])
}

// ============================================================================
// BROADCAST DESTINATIONS (Junction table for multi-streaming)
// ============================================================================

model BroadcastDestination {
  id            String      @id @default(cuid())
  status        String      @default("IDLE")

  // Parent broadcast
  broadcastId   String
  broadcast     Broadcast   @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  // Target destination
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  // Stream info
  startedAt     DateTime?
  endedAt       DateTime?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([broadcastId, destinationId])
  @@index([broadcastId])
  @@index([destinationId])
}
