# TURN Server Configuration
# Copy to .env and update values

# Your server's public IP address (REQUIRED)
EXTERNAL_IP=

# Domain for TURN server (e.g., turn.yourdomain.com)
TURN_REALM=turn.streamlick.com

# Authentication credentials (used by Streamlick clients)
TURN_USERNAME=streamlick
TURN_PASSWORD=change-this-to-a-strong-password

# TLS Certificate paths (optional, for TURNS)
# Get free certs with: certbot certonly --standalone -d turn.yourdomain.com
TURN_TLS_CERT=
TURN_TLS_KEY=

# Port configuration
TURN_PORT=3478
TURN_TLS_PORT=5349

# Relay port range (must be open in firewall)
MIN_RELAY_PORT=49152
MAX_RELAY_PORT=65535
